# 模型提供方:
#   cloud  = 默认, 不启动/不拉 Ollama 镜像和模型
#   ollama = 本地轻量测试, 部署脚本会启用 compose profile: ollama
#   auto   = 有云API配置走 cloud, 否则走 ollama
MODEL_PROVIDER=cloud

# 云 API 配置。平时推荐用这组, 兼容 OpenAI 格式的国内云 API 均可。
CLOUD_API_KEY=
CLOUD_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_LLM_MODEL=gpt-5.5
# 可选: 一次配置多个云模型(逗号分隔), 配置后可在 WebUI 侧边栏/「高级配置」对话框里
# 自由切换。留空则只列出上面的 CLOUD_LLM_MODEL 一个。
# 例: CLOUD_LLM_MODELS=gpt-5.5,gpt-5.2,gpt-4o
CLOUD_LLM_MODELS=

# =============================================
# DeepSeek 平台(可选, 独立 base_url / api_key)
# =============================================
# 填了 DEEPSEEK_API_KEY 就会额外注入一个 deepseek-api 平台,
# WebUI 的「模型平台 / 高级配置」下拉里即可与 cloud-api 自由切换。
# ⚠️ api.chiyi.cc 网关不提供 deepseek 模型, 必须用 DeepSeek 官方 key。
DEEPSEEK_API_KEY=
# 官方地址, 一般不用改
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# 可选模型(逗号分隔): deepseek-chat(通用) / deepseek-reasoner(推理)
DEEPSEEK_LLM_MODELS=deepseek-chat,deepseek-reasoner
# 可选: 直接把默认模型设为某个模型(如 deepseek-chat); 留空则用 CLOUD_LLM_MODEL
MTD_DEFAULT_LLM_MODEL=
# 如云厂商支持 embedding, 填上后知识库向量化也不依赖本地 Ollama。
# 示例: text-embedding-v3
CLOUD_EMBED_MODEL=

# 是否每次容器启动都重建知识库。默认关闭，避免启动时重复向量化。
# 配好 CLOUD_EMBED_MODEL 后，首次重建可临时改为 true。
KB_REBUILD_ON_START=false

# model_settings.yaml 的生成策略:
#   false(默认) = 启动时只把 .env 管理的平台(cloud-api/deepseek-api)和默认模型合并进
#                 已存在的文件，其它字段(自己加的平台、温度等)保留，不会被重启冲掉
#   true        = 每次启动都按 .env 全量重建，手工改动会被覆盖
MDT_REGEN_MODEL_SETTINGS=false

# 本地 Ollama 轻量测试配置。默认只拉最小 LLM: smollm2:135m (~0.27GB)。
# 医学 RAG 不建议用这个模型, 只用于验证服务链路。
OLLAMA_LLM_MODEL=smollm2:135m
OLLAMA_EMBED_MODEL=
OLLAMA_AUTO_PULL=true
# 兼容旧写法: 如需一次指定多个本地模型再取消注释, 仅 MODEL_PROVIDER=ollama 时生效。
# OLLAMA_MODELS=smollm2:135m

# Ngrok 认证令牌; 留空则不配置 token。
NGROK_AUTHTOKEN=

# ngrok 内网穿透开关:
#   true  = 启动 ngrok(默认); 即使连不上, 容器也会自动降级继续运行, 不会退出
#   false = 完全不启动 ngrok。隔离网络/无外网环境建议设为 false
ENABLE_NGROK=true

# Ollama 拉取模型代理（可选）
OLLAMA_HTTPS_PROXY=

# ChatChat 配置
CHATCHAT_DATA_PATH=./data
# =============================================
# 知识库上传自动云端备份(私有 Git 仓库)
# =============================================
# 开启后,在 WebUI 向知识库上传文件成功时,自动把本次上传的源文件 commit+push 到下方私有仓库。
# 关闭状态(false)下上传完全不受影响。

# 开关:true / false
KB_BACKUP_ENABLED=true

# 私有备份仓库 HTTPS 地址(不含 token),例如 https://github.com/you/kb-backup.git
# 注意:仓库必须是「完全空仓库」,创建时不要勾选 README/.gitignore/license
KB_BACKUP_REMOTE_URL=

# 细粒度 Personal Access Token,仅授予该备份仓库 Contents: Read and write。
# 只在本进程 push 时临时使用,不写入磁盘、不进代码仓库。留空则仅用于本地无认证测试。
KB_BACKUP_TOKEN=

# 备份分支(默认 main)
KB_BACKUP_BRANCH=main

# 本地备份 git 仓库路径;留空默认 <CHATCHAT_ROOT>/kb_backup_repo
KB_BACKUP_REPO_PATH=

# 提交作者(可选)
KB_BACKUP_COMMIT_AUTHOR_NAME=MDT
KB_BACKUP_COMMIT_AUTHOR_EMAIL=mdt@local
